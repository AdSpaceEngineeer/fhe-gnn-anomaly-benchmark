    "client_encrypt_input": ["$PYTHON", "-m", "fhe_gnn_anomaly_benchmark.tenseal_submission", "client_encrypt_input"],
    "server_encrypted_compute": ["$PYTHON", "-m", "fhe_gnn_anomaly_benchmark.tenseal_submission", "server_encrypted_compute"],
    "client_decrypt_output": ["$PYTHON", "-m", "fhe_gnn_anomaly_benchmark.tenseal_submission", "client_decrypt_output"],
